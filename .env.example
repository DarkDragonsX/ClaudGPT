
# ============================================================
# ClaudGPT - Environment Configuration
# Author: radlamine
# GitHub: https://github.com/RadLamine
# Repository: https://github.com/RadLamine/ClaudGPT
#
# IMPORTANT:
# 1. Configure the required values in this section first.
# 2. Keep the default values in the sections below unless you
#    understand what each setting does.
# 3. Never share your API keys or bot token publicly.
# ============================================================


# ============================================================
# 1. REQUIRED BOT CONFIGURATION
# ============================================================

# Telegram Bot Token.
# Create a bot using @BotFather on Telegram and paste its token.
BOT_TOKEN=

# Telegram Administrator ID.
# Enter your numeric Telegram user ID.
# You can obtain it using a Telegram ID bot.
ADMIN_ID=0


# ============================================================
# 2. AI API CONFIGURATION
# ============================================================

# Primary AI API Key.
# Enter your main API key here.
# The key must belong to a provider compatible with the API
# configuration implemented in this project.
AI_API_KEY=

# Backup AI API Keys.
# Enter additional API keys separated by commas.
# Example: key1,key2,key3
# These keys can be used when the primary key is unavailable
# or reaches its usage limit, depending on the implementation.
AI_API_KEYS=

# AI Request Timeout in seconds.
AI_TIMEOUT=120


# ============================================================
# 3. WEBSITE AND PUBLIC URL CONFIGURATION
# ============================================================

# Main website or project URL.
# Enter your website URL if you have one.
# Leave empty if you do not use a website.
SITE_URL=

# Bot Display Name.
BOT_NAME=ClaudGPT

# Bot Support or Information Link.
BMO_URL=https://t.me/dexwepbot

# Public URL provided by Render.
# Render automatically provides this variable when applicable.
# Leave empty when running locally or outside Render.
RENDER_EXTERNAL_URL=

# Server Port.
# Used by the web server when applicable.
PORT=5000


# ============================================================
# 4. CLOUDFLARE CONFIGURATION
# ============================================================

# Cloudflare Account ID.
# Enter your Cloudflare account ID.
# Required only if you use the Cloudflare image generation service.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token.
# Create an API token with the required permissions in Cloudflare.
# Never expose this token publicly.
CLOUDFLARE_API_TOKEN=

# Additional Cloudflare Accounts.
# Enter multiple account IDs separated by commas if supported.
# Leave empty if you use only one account.
CLOUDFLARE_ACCOUNTS=


# ============================================================
# 5. AI MODEL CONFIGURATION
# ============================================================

# Emergency AI Model.
# Model used as an emergency alternative when configured
# fallback mechanisms are triggered.
EMERGENCY_MODEL=openai/gpt-oss-20b

# Additional Fallback Models.
# Enter model identifiers separated by commas if multiple
# fallback models are supported by the project.
MODEL_FALLBACKS=openai/gpt-oss-20b

# Image Generation Model.
# Cloudflare Workers AI model identifier.
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Speech-to-Text Model.
STT_MODEL=whisper-large-v3-turbo

# Reasoning Effort for Agent Operations.
AGENTS_REASONING_EFFORT=medium

# Reasoning Effort for Normal Chat.
CHAT_REASONING_EFFORT=low

# General Reasoning Effort.
REASONING_EFFORT=medium


# ============================================================
# 6. AI GENERATION LIMITS
# ============================================================

# Maximum number of continuation requests.
MAX_CONTINUATIONS=10

# Maximum completion tokens per AI response.
MAX_COMPLETION_TOKENS=16384

# Maximum conversation memory size.
MEMORY_LIMIT=8000

# Maximum input characters.
MAX_INPUT_CHARS=8000


# ============================================================
# 7. FILE AND IMAGE LIMITS
# ============================================================

# Maximum code file size in bytes.
MAX_CODE_FILE_BYTES=61440

# Maximum uploaded image size in bytes.
MAX_IMAGE_BYTES=1048576

# Maximum temporary storage size in bytes.
MAX_TEMP_STORAGE_BYTES=5242880

# Maximum generated output file characters.
MAX_OUTPUT_FILE_CHARS=1000000

# Maximum PDF pages allowed.
MAX_PDF_PAGES=100

# Maximum extracted PDF text characters.
MAX_PDF_TEXT_CHARS=300000

# Maximum PDF text sent to AI.
MAX_PDF_AI_CHARS=100000

# Maximum PDF pages processed using OCR.
MAX_PDF_OCR_PAGES=30

# Maximum ZIP archive size in bytes.
MAX_ZIP_BYTES=5242880

# Maximum individual project file size in bytes.
MAX_PROJECT_FILE_BYTES=61440

# Maximum number of files in a project.
MAX_PROJECT_FILES=400

# Maximum extracted project size in bytes.
MAX_PROJECT_UNZIPPED=5242880

# Maximum project batch characters.
PROJECT_BATCH_CHARS=28000

# Maximum total project characters.
PROJECT_MAX_CHARS=600000

# Number of AI agents used for project processing.
PROJECT_AGENTS=2

# Delay between project processing operations in seconds.
PROJECT_WAIT_SEC=3

# Maximum number of files that can be fixed in one operation.
PROJECT_MAX_FIX_FILES=20

# Maximum words allowed when processing a file.
MAX_FILE_WORDS=15000


# ============================================================
# 8. REQUEST QUEUE AND CONCURRENCY
# ============================================================

# Maximum number of waiting tasks.
QUEUE_MAX_WAITING=100

# Maximum task execution time in seconds.
QUEUE_TASK_TIMEOUT=900

# Maximum simultaneous chat operations.
CHAT_CONCURRENCY=1

# Maximum simultaneous project operations.
PROJECT_CONCURRENCY=1

# Maximum simultaneous code editing operations.
CODE_EDIT_CONCURRENCY=1

# Maximum simultaneous PDF processing operations.
PDF_CONCURRENCY=1

# Maximum simultaneous background removal operations.
REMBG_CONCURRENCY=1


# ============================================================
# 9. RESOURCE PROTECTION
# ============================================================

# Emergency disk usage threshold in percent.
EMERGENCY_DISK_PCT=88

# Emergency RAM usage threshold in percent.
EMERGENCY_RAM_PCT=90

# Emergency database usage threshold in percent.
EMERGENCY_DB_PCT=88

# Emergency temporary storage threshold in percent.
EMERGENCY_TEMP_PCT=85

# Emergency request queue threshold in percent.
EMERGENCY_QUEUE_PCT=85

# Maximum batches in Lite mode.
LITE_MAX_BATCHES=2

# Maximum files that can be fixed in Lite mode.
LITE_MAX_FIX_FILES=5


# ============================================================
# 10. IMAGE GENERATION LIMITS
# ============================================================

# Maximum image generation requests per user per day.
IMAGE_DAILY_LIMIT=3


# ============================================================
# 11. DATABASE AND DATA RETENTION
# ============================================================

# Number of days to retain user records.
USER_RETENTION_DAYS=90

# Number of days to retain chat history.
CHAT_RETENTION_DAYS=30

# Maximum database size in megabytes.
DB_MAX_MB=140

# Maximum number of stored messages.
DB_MAX_MESSAGES=30000

# Maximum number of registered users.
DB_MAX_USERS=50000

# Maximum number of stored reports.
DB_MAX_REPORTS=5000

# Database file path.
DB_PATH=bot_data.db


# ============================================================
# 12. TEXT PROCESSING CONFIGURATION
# ============================================================

# Time zone offset from UTC in hours.
TZ_OFFSET_HOURS=1

# Scheduled database cleanup hour.
CLEAN_HOUR=0

# Cleanup threshold for inactive users in hours.
CLEAN_INACTIVE_HOURS=24

# Grace period before cleanup in minutes.
CLEAN_GRACE_MIN=20

# Maximum characters per reading chunk.
READ_CHUNK_CHARS=9000

# Maximum source characters used for summaries.
SUMMARY_SRC_CHARS=5500

# Maximum characters processed directly from files.
DIRECT_FILE_CHARS=5000


# ============================================================
# 13. BOT FEATURES
# ============================================================

# Enable or disable message reactions.
# 1 = Enabled
# 0 = Disabled
ENABLE_REACTIONS=1
